def botao(
    parent,
    texto,
    comando,
    cor=BOTAO,
    hover=BOTAO_HOVER
):

    return ctk.CTkButton(
        parent,
        text=texto,
        command=comando,
        height=27,
        corner_radius=6,
        fg_color=cor,
        hover_color=hover,
        border_width=1,
        border_color=BORDA,
        font=FONTE_BOTAO,
        text_color=BRANCO,
        cursor="hand2"
    )


