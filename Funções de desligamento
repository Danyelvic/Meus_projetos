# ============================================================
# FUNÇÕES DO PROGRAMA
# ============================================================

def desligar_pc_M(minutos):
    segundos = int(minutos * 60)
    os.system(f"shutdown /s /f /t {segundos}")

    if minutos > 0:
        messagebox.showinfo(
            "Aviso",
            f"O PC vai desligar em {minutos} minutos!"
        )


def desligar_pc_H(horas):
    segundos = int(horas * 3600)
    os.system(f"shutdown /s /f /t {segundos}")

    if horas > 0:
        messagebox.showinfo(
            "Aviso",
            f"O PC vai desligar em {horas} horas!"
        )


def reiniciar():
    os.system("shutdown /r /f /t 0")


def cancelar():
    os.system("shutdown /a")

    messagebox.showinfo(
        "Aviso",
        "Desligamento cancelado com sucesso! 👍"
    )


def agendar_desligamento():
    horario_texto = entrada_horario.get().strip()

    if not horario_texto:
        messagebox.showwarning(
            "Sem Horário",
            "Nenhum horário foi informado. Digite uma hora para agendar! 😊",
        )
        return

    try:
        agora = datetime.now()

        horario_alvo = datetime.strptime(
            f"{agora.strftime('%Y-%m-%d')} {horario_texto}",
            "%Y-%m-%d %H:%M"
        )

        segundos = int(
            (horario_alvo - agora).total_seconds()
        )

        if segundos <= 0:
            messagebox.showerror(
                "Horário Ultrapassado",
                "Esse horário já passou hoje! Escolha um horário futuro. 😅",
            )
            return

        os.system(
            f"shutdown /s /f /t {segundos}"
        )

        messagebox.showinfo(
            "Tudo Pronto!",
            f"Agendado com sucesso! Seu PC desligará às {horario_texto}. 🚀",
        )

    except ValueError:
        messagebox.showerror(
            "Formato Inválido",
            "Por favor, use o formato de hora correto (Ex: 23:30).",
        )


