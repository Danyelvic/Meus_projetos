def titulo_secao(parent, texto):

    frame = ctk.CTkFrame(
        parent,
        fg_color="transparent",
        height=17
    )

    frame.pack(
        fill="x",
        pady=(2, 1)
    )

    frame.pack_propagate(False)

    ctk.CTkLabel(
        frame,
        text=texto,
        font=FONTE_SECAO,
        text_color=BRANCO
    ).pack(
        side="left"
    )

    ctk.CTkFrame(
        frame,
        fg_color=BORDA,
        height=1
    ).pack(
        side="left",
        fill="x",
        expand=True,
        padx=(7, 0)
    )


